{
  "name": "nexusops",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @nexusops/api --filter @nexusops/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm exec playwright test",
    "db:generate": "pnpm --filter @nexusops/api prisma generate",
    "db:migrate": "pnpm --filter @nexusops/api prisma migrate deploy",
    "db:seed": "pnpm --filter @nexusops/api prisma db seed",
    "validate:static": "python scripts/validate/static_validate.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.0"
  }
}
